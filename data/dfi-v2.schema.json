{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfi.local/schemas/dfi-v2-example.json",
  "title": "DFI v2 scored claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "family_id",
    "split",
    "claim",
    "label",
    "domain",
    "fact_type",
    "prior_familiarity",
    "knowledge_audit",
    "claim_origin",
    "evidence_condition",
    "evidence_sets",
    "atomic_facts",
    "annotations",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "example_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "calibration", "test", "transfer"]},
    "claim": {"type": "string", "minLength": 1},
    "label": {
      "enum": ["supported", "refuted", "insufficient", "ambiguous"]
    },
    "domain": {"type": "string", "minLength": 1},
    "fact_type": {
      "enum": [
        "entity",
        "relation",
        "number",
        "date",
        "negation_or_sign",
        "qualifier",
        "comparison",
        "causal",
        "compositional",
        "other"
      ]
    },
    "prior_familiarity": {
      "enum": ["common", "long_tail", "unavailable", "unknown"]
    },
    "knowledge_audit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "status",
        "audit_version",
        "recognition_top1_rate",
        "cloze_recall_exact_rate",
        "forward_top1_rate",
        "median_correct_probability",
        "median_logprob_margin",
        "recognition_passed",
        "passed"
      ],
      "properties": {
        "checkpoint": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["recall_known", "recognition_known", "weak", "unknown"]
        },
        "audit_version": {"type": "string", "minLength": 1},
        "recognition_top1_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cloze_recall_exact_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "forward_top1_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "median_correct_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "median_logprob_margin": {"type": "number"},
        "recognition_passed": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "model_revision": {"type": "string"},
        "candidate_sha256": {"type": "string"},
        "audited_at": {"type": "string", "format": "date-time"}
      }
    },
    "claim_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "author"],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "minimal_edit",
            "paraphrase",
            "model_generated",
            "external_dataset"
          ]
        },
        "author": {"type": "string", "minLength": 1},
        "generator_model": {"type": ["string", "null"]},
        "generator_prompt_id": {"type": ["string", "null"]}
      }
    },
    "evidence_condition": {
      "enum": [
        "none",
        "gold_supporting",
        "gold_refuting",
        "insufficient",
        "irrelevant_similar",
        "conflicting",
        "retrieved",
        "poisoned"
      ]
    },
    "evidence_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "stance", "text", "source", "rationale_spans"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "stance": {
            "enum": ["supports", "refutes", "neutral", "conflicts"]
          },
          "text": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url_or_corpus_id",
              "publisher",
              "published_at",
              "accessed_at",
              "license"
            ],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "url_or_corpus_id": {"type": "string", "minLength": 1},
              "publisher": {"type": "string", "minLength": 1},
              "published_at": {"type": ["string", "null"]},
              "accessed_at": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1}
            }
          },
          "retrieval_rank": {"type": ["integer", "null"], "minimum": 1},
          "retrieval_score": {"type": ["number", "null"]},
          "rationale_spans": {
            "type": "array",
            "items": {"$ref": "#/$defs/span"}
          }
        }
      }
    },
    "atomic_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atomic_id", "text", "label", "claim_span"],
        "properties": {
          "atomic_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "label": {
            "enum": ["supported", "refuted", "insufficient", "ambiguous"]
          },
          "claim_span": {"$ref": "#/$defs/span"}
        }
      }
    },
    "contrast": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "paired_example_id",
        "edit_role",
        "original_span",
        "replacement_span"
      ],
      "properties": {
        "paired_example_id": {"type": "string", "minLength": 1},
        "edit_role": {
          "enum": [
            "entity",
            "relation",
            "number",
            "date",
            "negation_or_sign",
            "qualifier",
            "comparison",
            "causal",
            "other"
          ]
        },
        "original_span": {"$ref": "#/$defs/span"},
        "replacement_span": {"$ref": "#/$defs/span"}
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotator_ids",
        "agreement",
        "adjudication_status",
        "notes"
      ],
      "properties": {
        "annotator_ids": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "adjudication_status": {
          "enum": ["pending", "verified", "rejected"]
        },
        "notes": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "source_example_id", "created_at", "license"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "source_example_id": {"type": ["string", "null"]},
        "created_at": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    }
  }
}
